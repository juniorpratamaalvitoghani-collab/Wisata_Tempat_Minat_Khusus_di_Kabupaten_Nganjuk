<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#E3F2FD">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wisata Minat Khusus di Nganjuk"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"/>

    <Spinner
        android:id="@+id/spinnerKategori"
        android:layout_width="130dp"
        android:layout_height="45dp"
        android:background="#000080"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="Minat Pengunjung"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginTop="10dp"/>

    <Spinner
        android:id="@+id/spinnerMinat"
        android:layout_width="130dp"
        android:layout_height="45dp"
        android:background="#000080"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"/>

    <ListView
        android:id="@+id/listWisata"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="20dp"
        android:background="#000080"/>

    <Button
        android:id="@+id/btnRekomendasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REKOMENDASI WISATA"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LIHAT DETAIL"
        android:layout_marginTop="20dp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1976D2"/>

    <Button
        android:id="@+id/btnMaps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LIHAT LOKASI"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1976D2"/>

</LinearLayout>